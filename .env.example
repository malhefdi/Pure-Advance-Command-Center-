# Never commit real credentials. Configure these only in the deployment secret store.
COMMAND_CENTER_USERNAME=change-me
COMMAND_CENTER_PASSWORD=use-a-long-random-password
COMMAND_CENTER_DISPLAY_NAME=Authorized operator
COMMAND_CENTER_ROLE=operator

# Absolute path to a private .xlsx file mounted on the server. Never put the workbook in Git.
COMMAND_CENTER_FINANCIAL_MODEL_PATH=

# Local development only. This is ignored in production even when set.
COMMAND_CENTER_AUTH_DISABLED=false
